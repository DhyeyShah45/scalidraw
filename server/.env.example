# Copy to server/.env and fill in. Never commit the real file.

# Generate with: yarn workspace @scalidraw/server hash-password
AUTH_PASSWORD_HASH=

# Loopback only — Cloudflare Tunnel connects outbound, nothing listens publicly.
HOST=127.0.0.1
PORT=3010

DATA_DIR=./data

# Built frontend. Leave unset to run API-only (e.g. against the Vite dev server).
# STATIC_DIR=../excalidraw-app/build

SESSION_TTL_DAYS=30

# cloudflared terminates TLS and forwards over loopback, so the socket address
# is never the real client — trust the forwarded header for the login backoff.
TRUST_PROXY=true

# Set to false only for plain-http local development.
COOKIE_SECURE=true

SNAPSHOT_INTERVAL_MINUTES=10
SNAPSHOTS_PER_DOCUMENT=50
